# vigil-rs identity example
#
# Demonstrates per-role access control with four users defined in the layer
# file 010-identities.yaml:
#
#   metrics-bot   m3tr1cs!    metrics  — GET /v1/metrics only
#   reader        r3ad0nly!   read     — all GET endpoints
#   writer        wr1t3acc!   write    — read + service control
#   admin         adm1npass!  admin    — full access including identities
#
# Build (from the vigil-rs repo root):
#   podman build -f examples/identities/Containerfile -t vigil-identities .
#
# Run:
#   podman run --rm -d --name vigil-identities vigil-identities
#
# Try it over the TLS listener (127.0.0.1:8443, self-signed certificate):
# there each request gets the access of its user. Over the Unix socket, root
# in the container is admin anyway (bootstrap, see 010-identities.yaml), so a
# password cannot lower its access.
#
#   # the identities, with Source "layer" (root over the Unix socket):
#   podman exec vigil-identities vigil identities list
#
#   # reader can list services:
#   podman exec vigil-identities \
#     vigil --url https://127.0.0.1:8443 -k -u 'reader:r3ad0nly!' services list
#
#   # metrics-bot can fetch metrics:
#   podman exec vigil-identities \
#     curl -sk -u 'metrics-bot:m3tr1cs!' https://127.0.0.1:8443/v1/metrics
#
#   # metrics-bot is blocked from listing services (403):
#   podman exec vigil-identities \
#     curl -sk -o /dev/null -w '%{http_code}\n' \
#          -u 'metrics-bot:m3tr1cs!' https://127.0.0.1:8443/v1/services
#
#   # writer can restart a service, reader cannot (403):
#   podman exec vigil-identities \
#     vigil --url https://127.0.0.1:8443 -k -u 'writer:wr1t3acc!' services restart counter
#   podman exec vigil-identities \
#     vigil --url https://127.0.0.1:8443 -k -u 'reader:r3ad0nly!' services restart counter

# ---------------------------------------------------------------------------
# Stage 1 — build vigild + vigil
# ---------------------------------------------------------------------------
FROM docker.io/library/rust:alpine AS vigil-builder

RUN apk add --no-cache musl-dev

WORKDIR /vigil-rs
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

RUN cargo build --release --bin vigild --bin vigil

# ---------------------------------------------------------------------------
# Stage 2 — final image
# ---------------------------------------------------------------------------
FROM docker.io/library/alpine:3.21

RUN apk add --no-cache curl

# vigil supervisor daemon + CLI
COPY --from=vigil-builder /vigil-rs/target/release/vigild /usr/local/bin/vigild
COPY --from=vigil-builder /vigil-rs/target/release/vigil  /usr/local/bin/vigil

# Layers: services and identities
COPY examples/identities/layers/ /etc/vigil/layers/

# The socket is /run/vigil/vigild.sock (default --path-prefix /run/vigil).
# The TLS listener uses a self-signed certificate that vigild generates; only
# reachable inside the container here.
ENTRYPOINT ["/usr/local/bin/vigild", "--layers-dir", "/etc/vigil/layers", \
    "--tls-addr", "127.0.0.1:8443"]
