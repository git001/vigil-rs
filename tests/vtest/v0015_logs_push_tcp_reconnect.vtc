vtest "logs-push-addr: vigild reconnects TCP sink after disconnect"

shell { mkdir -p ${tmpdir}/layers }

process p1 "${vigild} --layers-dir ${tmpdir}/layers --socket ${tmpdir}/vigild.sock" -start

shell {
	for i in $(seq 1 50); do
		test -S ${tmpdir}/vigild.sock && break
		sleep 0.1
	done
	test -S ${tmpdir}/vigild.sock
}

# --- Round 1: start the sink on a free port, verify logs arrive ---
# tests/vtest/helpers/tcp_capture.py binds a free port and writes it to
# sink_port.txt once it listens.

shell {
	${vtestdir}/helpers/tcp_capture.py ${tmpdir}/sink_port.txt ${tmpdir}/sink1.txt \
		> /dev/null 2>&1 < /dev/null &
	echo $! > ${tmpdir}/sink1.pid
	for i in $(seq 1 50); do
		test -s ${tmpdir}/sink_port.txt && break
		sleep 0.1
	done
	test -s ${tmpdir}/sink_port.txt
}

# Layer fixtures/v0015/log-svc.yaml: a service pushing its logs to the sink;
# logs-push-addr has no env: support, so the port placeholder is replaced.
shell {
	sed "s/@SINK_PORT@/$(cat ${tmpdir}/sink_port.txt)/" \
		${vtestdir}/fixtures/v0015/log-svc.yaml > ${tmpdir}/layers/log-svc.yaml
	${vigil} --socket ${tmpdir}/vigild.sock replan
}

shell {
	for i in $(seq 1 40); do
		test -s ${tmpdir}/sink1.txt && \
			grep -q push-line ${tmpdir}/sink1.txt && break
		sleep 0.2
	done
	grep -q push-line ${tmpdir}/sink1.txt
}

# --- Kill the sink (simulates crash / network outage) ---

shell { kill $(cat ${tmpdir}/sink1.pid) 2>/dev/null || true }

# Give vigild time to notice the broken connection and enter backoff (500ms)
shell { sleep 1 }

# --- Round 2: restart the sink on the same port (vigild is configured for
# it), verify vigild reconnects and logs resume ---

shell {
	${vtestdir}/helpers/tcp_capture.py --port $(cat ${tmpdir}/sink_port.txt) \
		${tmpdir}/sink2_port.txt ${tmpdir}/sink2.txt \
		> /dev/null 2>&1 < /dev/null &
	echo $! > ${tmpdir}/sink2.pid
	for i in $(seq 1 50); do
		test -s ${tmpdir}/sink2_port.txt && break
		sleep 0.1
	done
	test -s ${tmpdir}/sink2_port.txt
}

shell {
	for i in $(seq 1 40); do
		test -s ${tmpdir}/sink2.txt && \
			grep -q push-line ${tmpdir}/sink2.txt && break
		sleep 0.2
	done
	grep -q push-line ${tmpdir}/sink2.txt
}

# Tear down
shell {
	kill $(cat ${tmpdir}/sink2.pid) 2>/dev/null || true
}

process p1 -kill TERM
process p1 -wait
