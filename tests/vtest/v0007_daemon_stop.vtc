vtest "POST /v1/vigild with action=stop shuts down the daemon"

# vigild with an empty layers directory; see v0006.
process p1 -winsz 200 400 "${vigild} --layers-dir ${vtestdir}/fixtures/empty --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"

# The daemon accepts the stop and shuts down.
client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method POST -url /v1/vigild -hdr "Host: localhost" \
		-hdr "Content-Type: application/json" \
		-body "{\"action\":\"stop\"}"
	rxresp
	expect resp.status == 200
} -run
process p1 -expect-text 0 0 "daemon stop requested via API"
process p1 -expect-text 0 0 "vigild exited"

# It exits by itself, with exit code 0.
process p1 -wait
