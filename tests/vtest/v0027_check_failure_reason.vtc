vtest "why a check fails: last-error in GET /v1/checks, vigil checks list/run, the log, the alert; GET /v1/health"

# The alert receiver: the first alert is the failure, with its reason in the
# message. "Connection: close" makes vigild open a new connection for the
# next alert, which s1 gets after its restart below. In the body patterns
# each "." matches one character of a JSON escape (\" or \n).
server s1 {
	rxreq
	expect req.method == POST
	expect req.body ~ "status.:.down."
	expect req.body ~ "message.:.check migrate-done failed: exit status 2: migration 42 pending..see /var/log/migrate.log."
	txresp -hdr "Connection: close"
} -start

# vigild loads the static layer directory fixtures/v0027: migrate-done
# fails with output until ${tmpdir}/check_marker exists. vigild logs to
# stdout, the terminal of p1; -expect-text waits there for a text.
process p1 -winsz 200 400 "env CHECK_MARKER=${tmpdir}/check_marker WEBHOOK_URL=http://${s1_addr}:${s1_port}/webhook ${vigild} --layers-dir ${vtestdir}/fixtures/v0027 --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"

# The log: "check failed" and "check is down" carry the reason, quoted, so
# the multi-line output stays on one log line.
process p1 -expect-text 0 0 {check is down}
process p1 -match-text 0 0 {check failed .*error="exit status 2: migration 42 pending\\nsee /var/log/migrate.log"}
process p1 -match-text 0 0 {check is down .*error="exit status 2: migration 42 pending\\nsee /var/log/migrate.log"}

# The alert arrived with the reason.
server s1 -wait

# GET /v1/checks: last-error has the exit status and both output lines.
client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/checks -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "last-error.:.exit status 2: migration 42 pending..see /var/log/migrate.log."
} -run

# vigil checks list: the first line of the reason, with … for the rest.
shell -expect {exit status 2: migration 42 pending …} {
	${vigil} --socket ${tmpdir}/vigild.sock checks list
}

# GET /v1/health: 502 while the ready check is down.
client c2 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/health -hdr "Host: localhost"
	rxresp
	expect resp.status == 502
	expect resp.body ~ "healthy.:false"
} -run

# level=ready counts the ready check: 502.
client c3 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url "/v1/health?level=ready" -hdr "Host: localhost"
	rxresp
	expect resp.status == 502
} -run

# level=alive does not look at a ready check: 200.
client c4 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url "/v1/health?level=alive" -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "healthy.:true"
} -run

# By name: 502.
client c5 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url "/v1/health?names=migrate-done" -hdr "Host: localhost"
	rxresp
	expect resp.status == 502
} -run

# A name that is not a check: 404.
client c6 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url "/v1/health?names=migrate-dnoe" -hdr "Host: localhost"
	rxresp
	expect resp.status == 404
	expect resp.body ~ "check ..migrate-dnoe.. not found"
} -run

# An unknown level: 400.
client c7 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url "/v1/health?level=live" -hdr "Host: localhost"
	rxresp
	expect resp.status == 400
} -run

# vigil checks run: runs it now; the state on stdout, the reason on stderr,
# exit code 1.
shell -exit 1 -match {migrate-done: failed \(status down[\s\S]*check migrate-done failed: exit status 2: migration 42 pending} {
	${vigil} --socket ${tmpdir}/vigild.sock checks run migrate-done
}

# An unknown check: the API answers 404, the CLI fails.
shell -exit 1 -expect {Error: check "no-such-check" not found} {
	${vigil} --socket ${tmpdir}/vigild.sock checks run no-such-check
}

# The recovery alert comes on a new connection.
server s1 {
	rxreq
	expect req.body ~ "status.:.up."
	txresp -hdr "Connection: close"
} -start

# The marker makes the check pass.
filewrite ${tmpdir}/check_marker ""
process p1 -expect-text 0 0 {check recovered}
server s1 -wait

# A pass clears last-error; GET /v1/health is 200 again.
client c8 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/checks -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body !~ "last-error"
} -run

client c9 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/health -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
} -run

# vigil checks run on a passing check: exit code 0.
shell -expect {migrate-done: passed (status up, failures 0/1)} {
	${vigil} --socket ${tmpdir}/vigild.sock checks run migrate-done
}

process p1 -kill TERM
process p1 -wait
