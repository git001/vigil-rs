vtest "--watch-layers: apply changed layers without replan, alert on invalid layers"

# The webhook endpoint gets the two layer events, one connection each:
# invalid, then recovered. vigild parses and re-serialises the rendered
# JSON, so the keys come sorted.
server s1 {
	rxreq
	expect req.url == /webhook
	expect req.body == "{\"event\":\"invalid\",\"name\":\"layers\",\"source\":\"vigild\"}"
	txresp -hdr "Connection: close"
	accept
	rxreq
	expect req.body == "{\"event\":\"recovered\",\"name\":\"layers\",\"source\":\"vigild\"}"
	txresp -hdr "Connection: close"
} -start

# The layers directory is a symlink to a static fixture directory; the test
# changes the plan by pointing it to another one, the way Kubernetes swaps
# the ..data symlink of a ConfigMap volume. VTest2 cannot make symlinks.
shell {ln -s ${vtestdir}/fixtures/v0024/start ${tmpdir}/layers}

# vigild checks the layers every second (--watch-layers 1s) and gets the
# webhook URL as WEBHOOK_URL. It logs to stdout, the terminal of p1;
# -expect-text waits there for a line. A wide terminal keeps long log lines
# on one row.
process p1 -winsz 200 400 "env WEBHOOK_URL=http://${s1_sock}/webhook ${vigild} --layers-dir ${tmpdir}/layers --socket ${tmpdir}/vigild.sock --watch-layers 1s" -start
process p1 -expect-text 0 0 "API listening"

# 1. A new layer is applied without "vigil replan": web shows up and starts.
shell {ln -sfn ${vtestdir}/fixtures/v0024/app ${tmpdir}/layers}
process p1 -expect-text 0 0 "process started service=web"
shell -match {web +enabled +active} { ${vigil} --socket ${tmpdir}/vigild.sock services list }

# 2. A broken layer next to it: the running plan stays, the alert reports
# it.
shell {ln -sfn ${vtestdir}/fixtures/v0024/broken ${tmpdir}/layers}
process p1 -expect-text 0 0 "layers are invalid, keeping the running plan"
client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/services -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "name.:.web.,.startup.:.enabled.,.current.:.active."
	expect resp.body !~ "worker"
} -run

# 3. The broken layer gone: the next reload succeeds and resolves the alert.
shell {ln -sfn ${vtestdir}/fixtures/v0024/app ${tmpdir}/layers}
server s1 -wait

# The metrics count the reloads by result. In the patterns "." stands for
# the braces and quotes of the label.
client c2 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/metrics -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "vigil_layers_reloads_total.result=.ok.. 2\n"
	expect resp.body ~ "vigil_layers_reloads_total.result=.invalid.. 1\n"
} -run

process p1 -kill TERM
process p1 -wait
