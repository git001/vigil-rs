vtest "body_template: webhook alert uses Jinja2 template instead of default payload"

# The webhook endpoint: one POST whose body must be exactly the rendered
# template, its three fields and nothing else (no timestamp, labels or info
# of the built-in webhook format). vigild parses and re-serialises the
# rendered JSON, so the keys come sorted.
server s1 {
	rxreq
	expect req.method == POST
	expect req.url == /webhook
	expect req.body == "{\"check\":\"tmpl-check\",\"status\":\"down\",\"text\":\"tmpl-check is down\"}"
	txresp -hdr "Connection: close"
} -start

# fixtures/v0016: tmpl-check fails (no marker file), the alert has a
# body-template. vigild gets the webhook URL and the marker path from its
# environment (url "env:WEBHOOK_URL", pass-env-glob CHECK_MARKER). It logs to
# stdout, the terminal of p1; -expect-text waits there for a line. A wide
# terminal keeps long log lines on one row.
process p1 -winsz 200 400 "env CHECK_MARKER=${tmpdir}/check_marker WEBHOOK_URL=http://${s1_sock}/webhook ${vigild} --layers-dir ${vtestdir}/fixtures/v0016 --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"
process p1 -expect-text 0 0 "check is down"

server s1 -wait

process p1 -kill TERM
process p1 -wait
