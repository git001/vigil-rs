vtest "vigild: --log-format json, SIGHUP/SIGUSR1/SIGUSR2 forwarding, and daemon restart"

# The layers directory is a symlink to a static fixture directory; the test
# changes the plan by pointing it to another one. VTest2 cannot make
# symlinks.
shell {ln -s ${vtestdir}/fixtures/v0019/before ${tmpdir}/layers}

# Part 1: --log-format json. vigild logs to stdout, the terminal of p1;
# -expect-text waits there for a line. A wide terminal keeps the JSON lines
# on one row.
process p1 -winsz 200 400 "${vigild} --layers-dir ${tmpdir}/layers --socket ${tmpdir}/vigild.sock --log-format json" -start
process p1 -expect-text 0 0 "\"level\":\"INFO\",\"fields\":"
process p1 -expect-text 0 0 "\"message\":\"API listening on"
process p1 -expect-text 0 0 "\"message\":\"process started\",\"service\":\"signal-sink\""

client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/system-info -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
} -run

# Part 2: SIGHUP, SIGUSR1 and SIGUSR2 go on to the services. VTest2 knows
# only a few signal names; the others are numbers (Linux: USR1 10, USR2 12).
process p1 -kill HUP
process p1 -expect-text 0 0 "received SIGHUP, forwarding to services"
process p1 -kill -10
process p1 -expect-text 0 0 "received SIGUSR1, forwarding to services"
process p1 -kill -12
process p1 -expect-text 0 0 "received SIGUSR2, forwarding to services"

# vigild still answers.
client c2 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/system-info -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
} -run

# Part 3: POST /v1/vigild restart re-executes vigild in the same process. It
# loads the layers again: the new plan has the service restarted.
shell {ln -sfn ${vtestdir}/fixtures/v0019/after ${tmpdir}/layers}
client c3 -connect ${tmpdir}/vigild.sock {
	txreq -method POST -url /v1/vigild -hdr "Host: localhost" \
		-hdr "Content-Type: application/json" \
		-body "{\"action\":\"restart\"}"
	rxresp
	expect resp.status == 200
} -run
process p1 -expect-text 0 0 "re-executing vigild"
process p1 -expect-text 0 0 "\"message\":\"process started\",\"service\":\"restarted\""

# The re-executed vigild serves requests, with the new plan.
client c4 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/services -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "name.:.restarted."
} -run

process p1 -kill TERM
process p1 -wait
