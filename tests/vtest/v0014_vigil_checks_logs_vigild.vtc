vtest "vigil checks list (formatting + next_run branches), logs, vigild status/stop"

# fixtures/v0014: logger echoes a line and is restarted, so `vigil logs` has
# entries; four checks cover the four "Next run" formats:
#   pending-check  delay: 1h             still in its initial delay: "pending"
#   fast-check     period: 30s, delay 0  after its first run ~30s:   "Xs"
#   medium-check   period: 2m,  delay 0  ~120s:                      "Xm Xs"
#   slow-check     period: 2h,  delay 0  ~7200s:                     "Xh Xm"
# vigild logs to stdout, the terminal of p1; -expect-text waits there for a
# line. A wide terminal keeps long log lines on one row.
process p1 -winsz 200 400 "${vigild} --layers-dir ${vtestdir}/fixtures/v0014 --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"

shell -match {(?s)version: +[0-9.]+.*uptime: +[0-9]+d [0-9]+h [0-9]+m [0-9]+s} {
	${vigil} --socket ${tmpdir}/vigild.sock vigild status
}

# The logger line reaches vigild's log once logger ran.
process p1 -expect-text 0 0 "[logger] vigil-log-entry"
# The checks with delay 0 run at once; exec "true" takes a few milliseconds.
delay 0.5

shell -match {(?s)pending-check +alive +up +0/3 +pending.*fast-check +alive +up +0/3 +[0-9]+s.*medium-check +alive +up +0/3 +[0-9]+m [0-9]+s.*slow-check +alive +up +0/3 +[0-9]+h [0-9]+m} {
	${vigil} --socket ${tmpdir}/vigild.sock checks list
}

shell -match {[[]logger[]] [[]stdout[]] vigil-log-entry} {
	${vigil} --socket ${tmpdir}/vigild.sock logs
}

# vigil vigild stop: vigild shuts down and exits with 0.
shell -expect "Daemon stop initiated." {
	${vigil} --socket ${tmpdir}/vigild.sock vigild stop
}
process p1 -expect-text 0 0 "daemon stop requested via API"
process p1 -wait
