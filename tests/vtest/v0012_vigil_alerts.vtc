vtest "vigil alerts list — unknown / down / up status branches"

# fixtures/v0012: ghost-check (startup: disabled) stays "unknown";
# flap-check fails until the marker file exists, then passes. vigild gets
# the marker path as CHECK_MARKER. It logs to stdout, the terminal of p1;
# -expect-text waits there for a line. A wide terminal keeps long log lines
# on one row.
process p1 -winsz 200 400 "env CHECK_MARKER=${tmpdir}/check_marker ${vigild} --layers-dir ${vtestdir}/fixtures/v0012 --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"
process p1 -expect-text 0 0 "check is down"

shell -match {(?s)alert-ghost +webhook +unknown +ghost-check.*alert-flap +webhook +down +flap-check} {
	${vigil} --socket ${tmpdir}/vigild.sock alerts list
}

# The marker appears: flap-check passes, Down -> Up.
filewrite ${tmpdir}/check_marker ""
process p1 -expect-text 0 0 "check recovered"

shell -match {alert-flap +webhook +up +flap-check} {
	${vigil} --socket ${tmpdir}/vigild.sock alerts list
}

process p1 -kill TERM
process p1 -wait
