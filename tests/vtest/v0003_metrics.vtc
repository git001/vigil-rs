vtest "GET /v1/metrics returns OpenMetrics content-type"

# vigild with an empty layers directory; see v0001.
process p1 -winsz 200 400 "${vigild} --layers-dir ${vtestdir}/fixtures/empty --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"

client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/metrics -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.http.Content-Type ~ "application/openmetrics-text"
	expect resp.body ~ "vigil_services_count 0"
	expect resp.body ~ "# EOF"
} -run

process p1 -kill TERM
process p1 -wait
