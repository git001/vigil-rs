vtest "GET /v1/logs supports ?n= and ?services= query parameters"

# vigild with an empty layers directory; see v0006.
process p1 -winsz 200 400 "${vigild} --layers-dir ${vtestdir}/fixtures/empty --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"

# Without parameters. In the body patterns each "." matches one character
# of a JSON escape.
client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/logs -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "result.:.]"
} -run

# With n=.
client c2 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url "/v1/logs?n=5" -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "result.:.]"
} -run

# With a services= filter that matches nothing: still a result array.
client c3 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url "/v1/logs?services=nonexistent" -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "result.:.]"
} -run

process p1 -kill TERM
process p1 -wait
