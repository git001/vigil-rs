vtest "Identity CRUD: add, list, remove"

# vigild with an empty layers directory. It logs to stdout, the terminal of
# p1; -expect-text waits there for a line. A wide terminal keeps long log
# lines on one row.
process p1 -winsz 200 400 "${vigild} --layers-dir ${vtestdir}/fixtures/empty --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"

# No identities yet (bootstrap): any local caller is admin. In the body
# patterns each "." matches one character of a JSON escape.
client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/identities -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "result.:.]"
} -run

# Add alice with local (any UID), so we stay admin after bootstrap ends.
client c2 -connect ${tmpdir}/vigild.sock {
	txreq -method POST -url /v1/identities -hdr "Host: localhost" \
		-hdr "Content-Type: application/json" \
		-body "{\"identities\":{\"alice\":{\"access\":\"admin\",\"local\":{}}}}"
	rxresp
	expect resp.status == 200
} -run

# Bootstrap ended: the Unix socket passes our UID as the peer credential,
# and alice's "local: {}" accepts any UID.
client c3 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/identities -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "name.:.alice."
	expect resp.body ~ "access.:.admin."
} -run

# Remove alice: the result names her.
client c4 -connect ${tmpdir}/vigild.sock {
	txreq -method DELETE -url /v1/identities -hdr "Host: localhost" \
		-hdr "Content-Type: application/json" \
		-body "{\"identities\":[\"alice\"]}"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "result.:..alice.]"
} -run

# Bootstrap again: the list is empty.
client c5 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/identities -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "result.:.]"
} -run

process p1 -kill TERM
process p1 -wait
