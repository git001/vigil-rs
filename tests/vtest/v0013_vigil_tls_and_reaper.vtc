vtest "vigild TLS listener (server.rs) and subreaper (reaper.rs)"

# vigild with a TLS listener on a free port and subreaper mode (--reaper:
# prctl(PR_SET_CHILD_SUBREAPER) and the SIGCHLD task). Without --cert/--key
# it generates a self-signed certificate. fixtures/v0013 has quick-exit, a
# service that exits at once and is restarted after 100ms, so SIGCHLD keeps
# coming. vigild logs to stdout, the terminal of p1; -expect-text waits
# there for a line. A wide terminal keeps long log lines on one row.
process p1 -winsz 200 400 "${vigild} --layers-dir ${vtestdir}/fixtures/v0013 --socket ${tmpdir}/vigild.sock --tls-addr 127.0.0.1:0 --reaper" -start
process p1 -expect-text 0 0 "API listening"
process p1 -expect-text 0 0 "subreaper mode enabled"

# Identities (the TLS API has no anonymous admin): a local admin keeps the
# Unix socket working once bootstrap ends; TLS calls below authenticate as
# admin-user / admpass (see fixtures/README.md).
shell -expect "Identity 'local-admin' added." {
	${vigil} --socket ${tmpdir}/vigild.sock identities add-local local-admin --access admin
}
client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method POST -url /v1/identities -hdr "Host: localhost" \
		-hdr "Content-Type: application/json" \
		-bodyfrom ${vtestdir}/fixtures/identities/admin-user.json
	rxresp
	expect resp.status == 200
} -run

# The TLS port vigild got is known only at run time: vigil system-info
# shows it. VTest2 cannot connect to such a port, so the TLS calls use vigil
# (self-signed certificate: --insecure).
shell {
	${vigil} --socket ${tmpdir}/vigild.sock system-info \
		| sed -n 's/^https-address: 127.0.0.1:\([0-9]*\)$/\1/p' > ${tmpdir}/tls_port
	test -s ${tmpdir}/tls_port
}

shell -match {(?s)version: +[0-9.]+.*https-address: 127[.]0[.]0[.]1:[0-9]+} {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user admin-user:admpass system-info
}
shell -match {quick-exit +enabled} {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user admin-user:admpass services list
}
shell -expect "No checks." {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user admin-user:admpass checks list
}
shell -expect "No log entries." {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user admin-user:admpass logs
}

# The subreaper reaps quick-exit, which vigild restarts after its backoff.
process p1 -expect-text 0 0 "process exited service=quick-exit success=true"
process p1 -expect-text 0 0 "backoff elapsed, restarting service=quick-exit"
shell -match {quick-exit +enabled +[a-z]+ +restart +restart +SIGTERM +0} {
	${vigil} --socket ${tmpdir}/vigild.sock services list
}

process p1 -kill TERM
process p1 -wait
