vtest "service alerts: backoff, recovered after healthy-time, checks of an unhealthy service stay quiet"

# The webhook endpoint gets exactly the service's two events, one connection
# each: backoff, then recovered. vigild parses and re-serialises the
# rendered JSON, so the keys come sorted.
server s1 {
	rxreq
	expect req.url == /webhook
	expect req.body == "{\"event\":\"backoff\",\"message\":\"exited with code 3, restarting in 1s\",\"name\":\"flaky\",\"source\":\"service\"}"
	txresp -hdr "Connection: close"
	accept
	rxreq
	expect req.body == "{\"event\":\"recovered\",\"message\":\"service flaky is healthy again\",\"name\":\"flaky\",\"source\":\"service\"}"
	txresp -hdr "Connection: close"
} -start

# fixtures/v0023: flaky fails once and keeps running on its second start;
# flaky-check fails until then, but belongs to flaky and stays quiet. vigild
# gets the webhook URL and the marker path from its environment (alert url
# "env:WEBHOOK_URL", pass-env-glob FLAKY_MARKER). It logs to stdout, the
# terminal of p1; -expect-text waits there for a line. A wide terminal keeps
# long log lines on one row.
process p1 -winsz 200 400 "env FLAKY_MARKER=${tmpdir}/flaky_marker WEBHOOK_URL=http://${s1_sock}/webhook ${vigild} --layers-dir ${vtestdir}/fixtures/v0023 --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"

# Both alerts arrive (about 1s backoff + 2s healthy-time).
server s1 -wait

# A little longer: a late alert of flaky-check would be a third one. In the
# pattern "." stands for the braces and quotes of the label.
delay 2
client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/metrics -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "vigil_alert_fire_count_total.alert=.ops.. 2\n"
} -run

# vigil alerts list shows what the alert is subscribed to.
shell -match {ops +webhook +.* +flaky-check, service:[*]} {
	${vigil} --socket ${tmpdir}/vigild.sock alerts list
}

process p1 -kill TERM
process p1 -wait
