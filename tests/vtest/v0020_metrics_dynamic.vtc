vtest "vigild metrics: service_active, alert_fire_count reflect runtime state"

# The webhook endpoint for the alert; any answer will do.
server s1 {
	rxreq
	expect req.method == POST
	txresp -hdr "Connection: close"
} -start

# fixtures/v0020: long-runner (a running service), dummy-check (always
# fails: nothing listens on port 1) and test-alert on it. vigild gets the
# webhook URL as WEBHOOK_URL ("env:" in the alert url). It logs to stdout,
# the terminal of p1; -expect-text waits there for a line. A wide terminal
# keeps long log lines on one row.
process p1 -winsz 200 400 "env WEBHOOK_URL=http://${s1_sock}/ ${vigild} --layers-dir ${vtestdir}/fixtures/v0020 --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"
process p1 -expect-text 0 0 "process started service=long-runner"

# dummy-check goes down (threshold 3) and the alert fires.
process p1 -expect-text 0 0 "check is down check=dummy-check"
server s1 -wait

# In the patterns "." stands for the braces and quotes of the labels.
client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/metrics -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.http.Content-Type ~ "application/openmetrics-text"
	expect resp.body ~ "vigil_service_active.service=.long-runner.. 1"
	expect resp.body ~ "vigil_service_info.service=.long-runner.. 1"
	expect resp.body ~ "vigil_services_count 1"
	expect resp.body ~ "vigil_service_start_count_total.service=.long-runner.. 1"
	expect resp.body ~ "vigil_alert_fire_count_total.alert=.test-alert.. [1-9]"
	expect resp.body ~ "vigil_check_failure_count_total.check=.dummy-check.,level=.alive.. [1-9]"
} -run

process p1 -kill TERM
process p1 -wait
