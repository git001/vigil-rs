vtest "POST /v1/replan reloads layers and returns 200"

# The layers directory is a symlink to a static fixture directory; the test
# changes the plan by pointing it to another one, the way Kubernetes swaps
# the ..data symlink of a ConfigMap volume. VTest2 cannot make symlinks.
shell {ln -s ${vtestdir}/fixtures/v0005/before ${tmpdir}/layers}

process p1 -winsz 200 400 "${vigild} --layers-dir ${tmpdir}/layers --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"

# A replan without changes: 200. An empty body is fine, replan has no
# parameters.
client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method POST -url /v1/replan -hdr "Host: localhost" \
		-hdr "Content-Type: application/json" -body "{}"
	rxresp
	expect resp.status == 200
} -run

# No service yet.
client c2 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/services -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "result.:.]"
} -run

# A layer with the service echo-svc appears; the replan loads it.
shell {ln -sfn ${vtestdir}/fixtures/v0005/after ${tmpdir}/layers}
client c3 -connect ${tmpdir}/vigild.sock {
	txreq -method POST -url /v1/replan -hdr "Host: localhost" \
		-hdr "Content-Type: application/json" -body "{}"
	rxresp
	expect resp.status == 200
} -run
process p1 -expect-text 0 0 "plan reloaded"

client c4 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/services -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "name.:.echo-svc."
} -run

process p1 -kill TERM
process p1 -wait
