vtest "GET /v1/system-info returns version, boot-id, start-time"

# vigild with an empty layers directory. It logs to stdout, the terminal of
# p1; -expect-text waits there for a line. A wide terminal keeps long log
# lines on one row.
process p1 -winsz 200 400 "${vigild} --layers-dir ${vtestdir}/fixtures/empty --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"

# In the body patterns each "." matches one character of a JSON escape.
client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/system-info -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "status.:.OK."
	expect resp.body ~ "version.:.[0-9]+[.][0-9]+[.][0-9]+"
	expect resp.body ~ "boot-id.:.[0-9a-f]+-[0-9a-f-]+."
	expect resp.body ~ "start-time.:.[0-9]+-[0-9]+-[0-9]+T"
} -run

process p1 -kill TERM
process p1 -wait
