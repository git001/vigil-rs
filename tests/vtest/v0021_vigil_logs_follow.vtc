vtest "vigil logs: --follow (SSE streaming), --services filter, -n limit, empty output"

# The layers directory is a symlink to a static fixture directory; the test
# changes the plan by pointing it to another one. VTest2 cannot make
# symlinks.
shell {ln -s ${vtestdir}/fixtures/v0021/before ${tmpdir}/layers}

# vigild logs to stdout, the terminal of p1; -expect-text waits there for a
# line. A wide terminal keeps long log lines on one row.
process p1 -winsz 200 400 "${vigild} --layers-dir ${tmpdir}/layers --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"

# Part 1: no service yet, an empty log store.
shell -expect "No log entries." { ${vigil} --socket ${tmpdir}/vigild.sock logs }

# Part 2: logger prints a line every 50ms.
shell {ln -sfn ${vtestdir}/fixtures/v0021/after ${tmpdir}/layers}
shell -expect "Replan completed." { ${vigil} --socket ${tmpdir}/vigild.sock replan }
process p1 -expect-text 0 0 "[logger] vigil-follow-line-2"

shell -match {[[]logger[]] [[]stdout[]] vigil-follow-line-0} {
	${vigil} --socket ${tmpdir}/vigild.sock logs
}

# Part 3: only the lines of logger.
shell -match {[[]logger[]] [[]stdout[]] vigil-follow-line-0} {
	${vigil} --socket ${tmpdir}/vigild.sock logs logger
}

# Part 4: -n 2, exactly the last two lines (there are more by now).
shell -match {^[^\n]+vigil-follow-line-[0-9]+\n[^\n]+vigil-follow-line-[0-9]+\n?$} {
	${vigil} --socket ${tmpdir}/vigild.sock logs -n 2
}

# Part 5: --follow streams new lines until it gets SIGINT, then exits with
# 0. It runs as p2; -expect-text waits on its terminal.
process p2 -winsz 100 200 "${vigil} --socket ${tmpdir}/vigild.sock logs --follow" -start
process p2 -expect-text 0 0 "[logger] [stdout] vigil-follow-line-"
process p2 -kill INT
process p2 -wait

process p1 -kill TERM
process p1 -wait
