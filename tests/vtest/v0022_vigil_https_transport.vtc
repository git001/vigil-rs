vtest "vigil CLI: Http transport branches via HTTPS (post, post_void, delete, follow_logs)"

shell { mkdir -p ${tmpdir}/layers }

shell {
	PORT=$(python3 -c "import socket; s=socket.socket(); s.bind(('127.0.0.1',0)); p=s.getsockname()[1]; s.close(); print(p)")
	echo "$PORT" > ${tmpdir}/tls_port.txt
}

shell {
	PORT=$(cat ${tmpdir}/tls_port.txt)
	${vigild} \
		--layers-dir ${tmpdir}/layers \
		--socket     ${tmpdir}/vigild.sock \
		--tls-addr   127.0.0.1:$PORT \
		>> ${tmpdir}/vigild.log 2>&1 < /dev/null &
	echo $! > ${tmpdir}/vigild.pid
}

shell {
	for i in $(seq 1 50); do
		test -S ${tmpdir}/vigild.sock && break
		sleep 0.1
	done
	test -S ${tmpdir}/vigild.sock
}

# ---------------------------------------------------------------------------
# Identities (since v4 the TLS API has no anonymous admin, S5): create them
# over the Unix socket first; TLS calls below authenticate as admin-user.
# The local identity keeps Unix-socket access working after bootstrap ends.
# ---------------------------------------------------------------------------

shell {
	${vigil} --socket ${tmpdir}/vigild.sock \
		identities add-local local-admin --access admin
}

# admin-user / admpass, see tests/vtest/fixtures/README.md
shell {
	curl -sf \
		--unix-socket ${tmpdir}/vigild.sock \
		-X POST http://localhost/v1/identities \
		-H "Content-Type: application/json" \
		-d @${vtestdir}/fixtures/identities/admin-user.json > /dev/null
}

shell {
	PORT=$(cat ${tmpdir}/tls_port.txt)
	for i in $(seq 1 30); do
		curl -sf --insecure https://127.0.0.1:$PORT/v1/system-info > /dev/null 2>&1 && break
		sleep 0.2
	done
}

# Add a service that produces continuous log output (startup: enabled → auto-starts on replan)
shell {
	cp ${vtestdir}/fixtures/v0022/svc.yaml ${tmpdir}/layers/
}

# ---------------------------------------------------------------------------
# All HTTPS calls below authenticate as admin-user (basic auth).
# ---------------------------------------------------------------------------

# post_void Http branch: replan (loads the service config and starts https-svc)
shell {
	PORT=$(cat ${tmpdir}/tls_port.txt)
	${vigil} --url https://127.0.0.1:$PORT --insecure --user admin-user:admpass replan
}

# Wait for log entries from https-svc
shell {
	for i in $(seq 1 80); do
		${vigil} --socket ${tmpdir}/vigild.sock logs 2>/dev/null \
			| grep -q https-svc-log && break
		sleep 0.1
	done
	${vigil} --socket ${tmpdir}/vigild.sock logs | grep -q https-svc-log
}

# follow_logs Http branch: stream SSE while https-svc is running
shell {
	PORT=$(cat ${tmpdir}/tls_port.txt)
	${vigil} --url https://127.0.0.1:$PORT --insecure --user admin-user:admpass logs --follow \
		>> ${tmpdir}/follow_https.txt 2>/dev/null &
	echo $! > ${tmpdir}/follow_pid.txt
}

shell {
	for i in $(seq 1 50); do
		test -s ${tmpdir}/follow_https.txt && break
		sleep 0.1
	done
	grep -q https-svc-log ${tmpdir}/follow_https.txt
}

# SIGINT → clean exit so profraw is flushed for coverage
shell { kill -INT $(cat ${tmpdir}/follow_pid.txt) 2>/dev/null || true }

shell {
	for i in $(seq 1 20); do
		kill -0 $(cat ${tmpdir}/follow_pid.txt) 2>/dev/null || break
		sleep 0.1
	done
}

# post Http branch: services_action (stop then start)
shell {
	PORT=$(cat ${tmpdir}/tls_port.txt)
	${vigil} --url https://127.0.0.1:$PORT --insecure --user admin-user:admpass services stop https-svc
}

shell {
	PORT=$(cat ${tmpdir}/tls_port.txt)
	${vigil} --url https://127.0.0.1:$PORT --insecure --user admin-user:admpass services start https-svc
}

# post Http branch over HTTPS: add a second identity, authenticated as admin-user
# extra-user / extrapass, see tests/vtest/fixtures/README.md
shell {
	PORT=$(cat ${tmpdir}/tls_port.txt)
	curl -sf --insecure --user admin-user:admpass \
		-X POST https://127.0.0.1:$PORT/v1/identities \
		-H "Content-Type: application/json" \
		-d @${vtestdir}/fixtures/identities/extra-user.json > /dev/null
}

# delete Http branch: remove_identities (needs Admin)
shell {
	PORT=$(cat ${tmpdir}/tls_port.txt)
	${vigil} --url https://127.0.0.1:$PORT --insecure \
		--user admin-user:admpass \
		identities remove extra-user
	${vigil} --socket ${tmpdir}/vigild.sock identities list > ${tmpdir}/ids.txt
	! grep -q extra-user ${tmpdir}/ids.txt
	grep -q admin-user ${tmpdir}/ids.txt
}

# ---------------------------------------------------------------------------
# Tear down
# ---------------------------------------------------------------------------

shell {
	kill $(cat ${tmpdir}/vigild.pid) 2>/dev/null || true
	for i in $(seq 1 30); do
		kill -0 $(cat ${tmpdir}/vigild.pid) 2>/dev/null || break
		sleep 0.1
	done
}
