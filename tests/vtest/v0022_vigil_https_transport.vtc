vtest "vigil CLI: Http transport branches via HTTPS (post, post_void, delete, follow_logs)"

# The layers directory is a symlink to a static fixture directory; the test
# changes the plan by pointing it to another one. VTest2 cannot make
# symlinks. VTest2 has no TLS either: the HTTPS calls use vigil (--insecure
# for the self-signed certificate).
shell {ln -s ${vtestdir}/fixtures/v0022/before ${tmpdir}/layers}

# vigild with a TLS listener on a free port. It logs to stdout, the terminal
# of p1; -expect-text waits there for a line. A wide terminal keeps long log
# lines on one row.
process p1 -winsz 200 400 "${vigild} --layers-dir ${tmpdir}/layers --socket ${tmpdir}/vigild.sock --tls-addr 127.0.0.1:0" -start
process p1 -expect-text 0 0 "API listening"

# The TLS port vigild got is known only at run time; vigil system-info
# shows it.
shell {
	${vigil} --socket ${tmpdir}/vigild.sock system-info \
		| sed -n 's/^https-address: 127.0.0.1:\([0-9]*\)$/\1/p' > ${tmpdir}/tls_port
	test -s ${tmpdir}/tls_port
}

# Identities (the TLS API has no anonymous admin): a local admin keeps the
# Unix socket working once bootstrap ends; the HTTPS calls authenticate as
# admin-user / admpass (see fixtures/README.md).
shell -expect "Identity 'local-admin' added." {
	${vigil} --socket ${tmpdir}/vigild.sock identities add-local local-admin --access admin
}
client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method POST -url /v1/identities -hdr "Host: localhost" \
		-hdr "Content-Type: application/json" \
		-bodyfrom ${vtestdir}/fixtures/identities/admin-user.json
	rxresp
	expect resp.status == 200
} -run

# post_void over HTTPS: replan loads https-svc, which prints a line every
# 50ms.
shell {ln -sfn ${vtestdir}/fixtures/v0022/after ${tmpdir}/layers}
shell -expect "Replan completed." {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user admin-user:admpass replan
}
process p1 -expect-text 0 0 "[https-svc] https-svc-log"

# follow_logs over HTTPS: runs as p2 until SIGINT, then exits with 0.
process p2 -winsz 100 200 "${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure --user admin-user:admpass logs --follow" -start
process p2 -expect-text 0 0 "[https-svc] [stdout] https-svc-log"
process p2 -kill INT
process p2 -wait

# post over HTTPS: stop and start the service.
shell -expect {[done]: Stop ["https-svc"]} {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user admin-user:admpass services stop https-svc
}
shell -expect {[done]: Start ["https-svc"]} {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user admin-user:admpass services start https-svc
}

# post_void and delete over HTTPS: add an identity, then remove it.
shell -expect "Identity 'extra-local' added." {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user admin-user:admpass identities add-local extra-local --access read
}
shell -match {extra-local +read} {
	${vigil} --socket ${tmpdir}/vigild.sock identities list
}
shell -expect "Removed: extra-local" {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user admin-user:admpass identities remove extra-local
}
# What is left: admin-user and local-admin, no extra-local.
shell -match {^Name[^\n]*\n-+\nadmin-user +admin +basic +api\nlocal-admin +admin +local[(]any[)] +api\n?$} {
	${vigil} --socket ${tmpdir}/vigild.sock identities list
}

process p1 -kill TERM
process p1 -wait
