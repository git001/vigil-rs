vtest "identities in layer files: read-only over the API, rotated secret, removed by replan"

# fixtures/v0026/001-auth.yaml defines the read identity log-relay; its
# password hash comes from secrets/log-relay.hash, like a mounted Kubernetes
# Secret: extrapass at first, admpass after the rotation. password-hash-file
# has no env: support, so the test fills in its directory. The layers
# directory is a symlink, so the test can point it to the plan without the
# identity later. VTest2 cannot make symlinks.
shell {
	mkdir ${tmpdir}/before ${tmpdir}/secrets
	cp ${vtestdir}/fixtures/v0026/log-relay-extrapass.hash ${tmpdir}/secrets/log-relay.hash
	sed "s|@SECRET_DIR@|${tmpdir}/secrets|" \
		${vtestdir}/fixtures/v0026/001-auth.yaml > ${tmpdir}/before/001-auth.yaml
	ln -s ${tmpdir}/before ${tmpdir}/layers
}

# vigil-log-relay reaches vigild over TLS: there the identity decides. On
# the Unix socket this test's UID is vigild's own and keeps the bootstrap
# admin, since no identity was added over the API. vigild logs to stdout,
# the terminal of p1; -expect-text waits there for a line. A wide terminal
# keeps long log lines on one row.
process p1 -winsz 200 400 "${vigild} --layers-dir ${tmpdir}/layers --socket ${tmpdir}/vigild.sock --tls-addr 127.0.0.1:0 --watch-layers 1s" -start
# "watching layers" comes once the layers are loaded and the watcher knows
# the state they were loaded in ("API listening" comes before the layers
# are loaded).
process p1 -expect-text 0 0 "watching layers"

# The TLS port vigild got is known only at run time; vigil system-info
# shows it. VTest2 has no TLS: the TLS calls use vigil (--insecure for the
# self-signed certificate).
shell {
	${vigil} --socket ${tmpdir}/vigild.sock system-info \
		| sed -n 's/^https-address: 127.0.0.1:\([0-9]*\)$/\1/p' > ${tmpdir}/tls_port
	test -s ${tmpdir}/tls_port
}

# 1. Basic auth over TLS with the layer identity: read yes, write no, a
#    wrong password nothing.
shell -expect "No services." {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user log-relay:extrapass services list
}
shell -exit 1 -expect "Error: forbidden" {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user log-relay:extrapass replan
}
shell -exit 1 -expect "Error: forbidden" {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user log-relay:wrong services list
}

# 2. Listed with its source.
shell -match {log-relay +read +basic +layer 001-auth} {
	${vigil} --socket ${tmpdir}/vigild.sock identities list
}

# 3. Read-only over the API: remove fails with a clear message.
shell -exit 1 -expect {is defined in layer "001-auth"} {
	${vigil} --socket ${tmpdir}/vigild.sock identities remove log-relay
}

# 4. The Secret is rotated (written atomically, like the kubelet does):
#    --watch-layers picks it up without a change to the layer file.
shell {
	cp ${vtestdir}/fixtures/v0026/log-relay-admpass.hash ${tmpdir}/secrets/.new
	mv ${tmpdir}/secrets/.new ${tmpdir}/secrets/log-relay.hash
}
process p1 -expect-text 0 0 "plan reloaded"
shell -expect "No services." {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user log-relay:admpass services list
}
shell -exit 1 -expect "Error: forbidden" {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user log-relay:extrapass services list
}

# 5. The identity removed from the layer: access gone after the replan.
shell {ln -sfn ${vtestdir}/fixtures/v0026/after ${tmpdir}/layers}
shell -expect "Replan completed." { ${vigil} --socket ${tmpdir}/vigild.sock replan }
shell -exit 1 -expect "Error: forbidden" {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user log-relay:admpass services list
}

process p1 -kill TERM
process p1 -wait
