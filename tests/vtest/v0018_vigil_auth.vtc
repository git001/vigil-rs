vtest "vigil CLI: local, basic-auth, and mTLS authentication"

# VTest2 has no TLS: the certificates are made with openssl, the TLS calls
# use vigil (--cert/--key for mTLS, --insecure for the self-signed server
# certificate).
shell { mkdir ${tmpdir}/certs }

# ---------------------------------------------------------------------------
# Generate CA cert + client cert (mTLS)
# ---------------------------------------------------------------------------

shell {
	openssl req -x509 \
		-newkey ec -pkeyopt ec_paramgen_curve:P-256 \
		-keyout ${tmpdir}/certs/ca.key \
		-out    ${tmpdir}/certs/ca.crt \
		-days 1 -nodes \
		-subj "/CN=test-ca" \
		-addext "basicConstraints=critical,CA:true" \
		-addext "keyUsage=critical,keyCertSign,cRLSign" \
		2>/dev/null
}

shell {
	openssl req \
		-newkey ec -pkeyopt ec_paramgen_curve:P-256 \
		-keyout ${tmpdir}/certs/client.key \
		-out    ${tmpdir}/certs/client.csr \
		-nodes -subj "/CN=test-client" \
		2>/dev/null
	printf "subjectAltName=DNS:test-client\nextendedKeyUsage=clientAuth" \
		> ${tmpdir}/certs/client_ext.cnf
	openssl x509 -req \
		-in     ${tmpdir}/certs/client.csr \
		-CA     ${tmpdir}/certs/ca.crt \
		-CAkey  ${tmpdir}/certs/ca.key \
		-CAcreateserial \
		-out    ${tmpdir}/certs/client.crt \
		-days 1 -extfile ${tmpdir}/certs/client_ext.cnf \
		2>/dev/null
}

# vigild with TLS and mTLS on a free port. It logs to stdout, the terminal
# of p1; -expect-text waits there for a line. A wide terminal keeps long log
# lines on one row.
process p1 -winsz 200 400 "${vigild} --layers-dir ${vtestdir}/fixtures/empty --socket ${tmpdir}/vigild.sock --tls-addr 127.0.0.1:0 --tls-client-ca ${tmpdir}/certs/ca.crt" -start
process p1 -expect-text 0 0 "API listening"

# The TLS port vigild got is known only at run time; vigil system-info
# shows it.
shell {
	${vigil} --socket ${tmpdir}/vigild.sock system-info \
		| sed -n 's/^https-address: 127.0.0.1:\([0-9]*\)$/\1/p' > ${tmpdir}/tls_port
	test -s ${tmpdir}/tls_port
}

# The three kinds of identities. The first one ends bootstrap, so the local
# one comes first and keeps the Unix socket working.
shell -expect "Identity 'local-admin' added." {
	${vigil} --socket ${tmpdir}/vigild.sock identities add-local local-admin --access admin
}
# deploy / secret, access write (fixtures/identities/deploy-user.json; the
# hash and how it was made are in fixtures/README.md).
client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method POST -url /v1/identities -hdr "Host: localhost" \
		-hdr "Content-Type: application/json" \
		-bodyfrom ${vtestdir}/fixtures/identities/deploy-user.json
	rxresp
	expect resp.status == 200
} -run
# ops, access read, for any certificate signed by ca.crt; the helper writes
# the request body with the CA.
shell {
	${vtestdir}/helpers/tls_identity.py ops read ${tmpdir}/certs/ca.crt ${tmpdir}/tls_payload.json
}
client c2 -connect ${tmpdir}/vigild.sock {
	txreq -method POST -url /v1/identities -hdr "Host: localhost" \
		-hdr "Content-Type: application/json" \
		-bodyfrom ${tmpdir}/tls_payload.json
	rxresp
	expect resp.status == 200
} -run

shell -match {(?s)deploy +write +basic.*local-admin +admin +local.*ops +read +tls} {
	${vigil} --socket ${tmpdir}/vigild.sock identities list
}

# 1. Local: the socket's peer UID matches local-admin.
shell -expect "No services." { ${vigil} --socket ${tmpdir}/vigild.sock services list }

# 2. Basic auth over HTTPS: deploy (write) may read the services.
shell -expect "No services." {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user deploy:secret services list
}
# A wrong password is no identity.
shell -exit 1 -expect "Error: forbidden" {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--user deploy:wrongpass services list
}

# 3. mTLS: ops (read) may read the services.
shell -expect "No services." {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--cert ${tmpdir}/certs/client.crt --key ${tmpdir}/certs/client.key \
		services list
}
# Without a certificate: anonymous, the services are forbidden.
shell -exit 1 -expect "Error: forbidden" {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure services list
}

process p1 -kill TERM
process p1 -wait
