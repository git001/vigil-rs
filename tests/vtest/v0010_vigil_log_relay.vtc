vtest "vigil-log-relay source-socket forwards logs to TCP sink"

# vigild starts log-svc, which prints relay-test-line-N every 0.2s. It logs
# to stdout, the terminal of p1; -expect-text waits there for a line. A wide
# terminal keeps long log lines on one row.
process p1 -winsz 200 400 "${vigild} --layers-dir ${vtestdir}/fixtures/v0010 --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"
process p1 -expect-text 0 0 "[log-svc] relay-test-line-0"

# VTest2 can neither check the content of a raw TCP stream nor connect to a
# port known only at run time (the relay's healthcheck on :0), so the TCP
# sink is a helper and the healthcheck uses curl.

# Start a TCP sink (tests/vtest/helpers/tcp_capture.py) that appends what it
# receives to relay-output.txt; it binds a free port and writes it to
# sink_port.txt once it listens. All three fds are redirected so the sink
# does not hold the VTest2 output pipe open.
shell {
	${vtestdir}/helpers/tcp_capture.py ${tmpdir}/sink_port.txt ${tmpdir}/relay-output.txt \
		> /dev/null 2>&1 < /dev/null &
	echo $! > ${tmpdir}/sink.pid
	for i in $(seq 1 50); do
		test -s ${tmpdir}/sink_port.txt && break
		sleep 0.1
	done
	test -s ${tmpdir}/sink_port.txt
}

# Start vigil-log-relay in source-socket mode.
# Same fd discipline: all three redirected so the VTest2 pipe gets no writers.
shell {
	PORT=$(cat ${tmpdir}/sink_port.txt)
	${vigil_log_relay} \
		--source-socket ${tmpdir}/vigild.sock \
		--source-path "/v1/logs/follow?format=ndjson" \
		--tcp-sink-host 127.0.0.1 \
		--tcp-sink-port $PORT \
		--healthcheck 127.0.0.1:0 \
		--log-format json \
		--source-reconnect-retries 5 \
		>> ${tmpdir}/relay.log 2>&1 < /dev/null &
	echo $! > ${tmpdir}/relay.pid
}

# Wait for at least one forwarded log line
shell {
	for i in $(seq 1 50); do
		test -s ${tmpdir}/relay-output.txt && \
			grep -q relay-test-line ${tmpdir}/relay-output.txt && break
		sleep 0.2
	done
	grep -q relay-test-line ${tmpdir}/relay-output.txt
}

# Verify the forwarded JSON contains the service name and message
shell {
	grep relay-test-line ${tmpdir}/relay-output.txt | head -1 > ${tmpdir}/sample.txt
	grep -q log-svc ${tmpdir}/sample.txt
}

# Healthcheck endpoint should respond 200
shell {
	# The relay binds a free port (--healthcheck 127.0.0.1:0) and logs it.
	for i in $(seq 1 20); do
		HPORT=$(grep 'healthcheck listening' ${tmpdir}/relay.log \
			| sed -n 's/.*"addr":"[^"]*:\([0-9]*\)".*/\1/p')
		test -n "$HPORT" && curl -sf http://127.0.0.1:$HPORT/healthz && break
		sleep 0.2
	done
	curl -sf http://127.0.0.1:$HPORT/healthz
}

# --stdout-sink: stdout carries only the forwarded ndjson lines (no blank
# lines, no log messages); the relay's own logs go to stderr.
shell {
	${vigil_log_relay} \
		--source-socket ${tmpdir}/vigild.sock \
		--stdout-sink \
		--healthcheck 127.0.0.1:0 \
		> ${tmpdir}/stdout-sink.out 2> ${tmpdir}/stdout-sink.err < /dev/null &
	echo $! > ${tmpdir}/relay2.pid
	for i in $(seq 1 50); do
		test "$(grep -c relay-test-line ${tmpdir}/stdout-sink.out)" -ge 2 && break
		sleep 0.2
	done
	kill $(cat ${tmpdir}/relay2.pid)
	test "$(grep -c relay-test-line ${tmpdir}/stdout-sink.out)" -ge 2
	! grep -v '^{.*}$' ${tmpdir}/stdout-sink.out
	grep -q 'vigil-log-relay starting' ${tmpdir}/stdout-sink.err
}

# Tear down
shell {
	kill $(cat ${tmpdir}/relay.pid) 2>/dev/null || true
	kill $(cat ${tmpdir}/sink.pid) 2>/dev/null || true
}

process p1 -kill TERM
process p1 -wait
