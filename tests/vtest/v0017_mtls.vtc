vtest "mTLS client certificate authentication"

# VTest2 has no TLS: the certificates are made with openssl, the TLS calls
# use vigil (--cert/--key for mTLS, --insecure for the self-signed server
# certificate).
shell { mkdir ${tmpdir}/certs }

# ---------------------------------------------------------------------------
# Generate CA cert + client cert signed by that CA
# ---------------------------------------------------------------------------

shell {
	# CA key + self-signed cert with basicConstraints + keyCertSign
	openssl req -x509 \
		-newkey ec -pkeyopt ec_paramgen_curve:P-256 \
		-keyout ${tmpdir}/certs/ca.key \
		-out    ${tmpdir}/certs/ca.crt \
		-days 1 -nodes \
		-subj "/CN=test-ca" \
		-addext "basicConstraints=critical,CA:true" \
		-addext "keyUsage=critical,keyCertSign,cRLSign" \
		2>/dev/null
}

shell {
	# Client key + CSR
	openssl req \
		-newkey ec -pkeyopt ec_paramgen_curve:P-256 \
		-keyout ${tmpdir}/certs/client.key \
		-out    ${tmpdir}/certs/client.csr \
		-nodes \
		-subj "/CN=test-client" \
		2>/dev/null
	# Sign client cert with extendedKeyUsage=clientAuth and SAN (required by webpki)
	printf "subjectAltName=DNS:test-client\nextendedKeyUsage=clientAuth" \
		> ${tmpdir}/certs/client_ext.cnf
	openssl x509 -req \
		-in     ${tmpdir}/certs/client.csr \
		-CA     ${tmpdir}/certs/ca.crt \
		-CAkey  ${tmpdir}/certs/ca.key \
		-CAcreateserial \
		-out    ${tmpdir}/certs/client.crt \
		-days 1 \
		-extfile ${tmpdir}/certs/client_ext.cnf \
		2>/dev/null
}

# An untrusted CA and a client certificate signed by it.
shell {
	# Generate an untrusted CA + client cert
	openssl req -x509 \
		-newkey ec -pkeyopt ec_paramgen_curve:P-256 \
		-keyout ${tmpdir}/certs/bad-ca.key \
		-out    ${tmpdir}/certs/bad-ca.crt \
		-days 1 -nodes \
		-subj "/CN=bad-ca" 2>/dev/null
	openssl req \
		-newkey ec -pkeyopt ec_paramgen_curve:P-256 \
		-keyout ${tmpdir}/certs/bad-client.key \
		-out    ${tmpdir}/certs/bad-client.csr \
		-nodes -subj "/CN=bad-client" 2>/dev/null
	openssl x509 -req \
		-in     ${tmpdir}/certs/bad-client.csr \
		-CA     ${tmpdir}/certs/bad-ca.crt \
		-CAkey  ${tmpdir}/certs/bad-ca.key \
		-CAcreateserial \
		-out    ${tmpdir}/certs/bad-client.crt \
		-days 1 2>/dev/null
}

# vigild with mTLS on a free port, trusting ca.crt for client certificates.
# It logs to stdout, the terminal of p1; -expect-text waits there for a
# line. A wide terminal keeps long log lines on one row.
process p1 -winsz 200 400 "${vigild} --layers-dir ${vtestdir}/fixtures/empty --socket ${tmpdir}/vigild.sock --tls-addr 127.0.0.1:0 --tls-client-ca ${tmpdir}/certs/ca.crt" -start
process p1 -expect-text 0 0 "API listening"

# The TLS port vigild got is known only at run time; vigil system-info
# shows it.
shell {
	${vigil} --socket ${tmpdir}/vigild.sock system-info \
		| sed -n 's/^https-address: 127.0.0.1:\([0-9]*\)$/\1/p' > ${tmpdir}/tls_port
	test -s ${tmpdir}/tls_port
}

# A local admin keeps the Unix socket working once bootstrap ends.
client c1 -connect ${tmpdir}/vigild.sock {
	txreq -method POST -url /v1/identities -hdr "Host: localhost" \
		-hdr "Content-Type: application/json" \
		-body "{\"identities\":{\"local-admin\":{\"access\":\"admin\",\"local\":{}}}}"
	rxresp
	expect resp.status == 200
} -run

# The TLS identity ops (read) for certificates signed by ca.crt; the helper
# writes the request body with the CA's fingerprint.
shell {
	${vtestdir}/helpers/tls_identity.py ops read ${tmpdir}/certs/ca.crt ${tmpdir}/identity_payload.json
}
client c2 -connect ${tmpdir}/vigild.sock {
	txreq -method POST -url /v1/identities -hdr "Host: localhost" \
		-hdr "Content-Type: application/json" \
		-bodyfrom ${tmpdir}/identity_payload.json
	rxresp
	expect resp.status == 200
} -run

# Both identities are stored. In the body patterns each "." matches one
# character of a JSON escape.
client c3 -connect ${tmpdir}/vigild.sock {
	txreq -method GET -url /v1/identities -hdr "Host: localhost"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "name.:.local-admin."
	expect resp.body ~ "name.:.ops.,.access.:.read."
} -run

# With the client certificate: ops, read access, the services list works.
shell -expect "No services." {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--cert ${tmpdir}/certs/client.crt --key ${tmpdir}/certs/client.key \
		services list
}

# Without a certificate: anonymous (metrics), the services list is
# forbidden.
shell -exit 1 -expect "Error: forbidden" {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure services list
}

# A certificate of the untrusted CA: vigild rejects the handshake.
shell -exit 1 -expect "received fatal alert: UnknownCA" {
	${vigil} --url https://127.0.0.1:$(cat ${tmpdir}/tls_port) --insecure \
		--cert ${tmpdir}/certs/bad-client.crt --key ${tmpdir}/certs/bad-client.key \
		services list
}

process p1 -kill TERM
process p1 -wait
