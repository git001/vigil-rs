vtest "vigil CLI commands against a running vigild"

# The layers directory is a symlink to a static fixture directory; the test
# changes the plan by pointing it to another one. VTest2 cannot make
# symlinks.
shell {ln -s ${vtestdir}/fixtures/v0009/before ${tmpdir}/layers}

# vigild logs to stdout, the terminal of p1; -expect-text waits there for a
# line. A wide terminal keeps long log lines on one row.
process p1 -winsz 200 400 "${vigild} --layers-dir ${tmpdir}/layers --socket ${tmpdir}/vigild.sock" -start
process p1 -expect-text 0 0 "API listening"

shell -match {(?s)version: +[0-9.]+.*boot-id: +[0-9a-f-]+} {
	${vigil} --socket ${tmpdir}/vigild.sock system-info
}
shell -expect "No services." { ${vigil} --socket ${tmpdir}/vigild.sock services list }
shell -expect "No checks." { ${vigil} --socket ${tmpdir}/vigild.sock checks list }
shell -expect "No alerts." { ${vigil} --socket ${tmpdir}/vigild.sock alerts list }
shell -expect "No log entries." { ${vigil} --socket ${tmpdir}/vigild.sock logs }
shell -expect "Replan completed." { ${vigil} --socket ${tmpdir}/vigild.sock replan }

# A layer with demo-svc (startup: disabled) appears; replan loads it.
shell {ln -sfn ${vtestdir}/fixtures/v0009/after ${tmpdir}/layers}
shell -expect "Replan completed." { ${vigil} --socket ${tmpdir}/vigild.sock replan }
shell -match {demo-svc +disabled +inactive} {
	${vigil} --socket ${tmpdir}/vigild.sock services list
}

# Start it: active once the process runs.
shell -expect {[done]: Start ["demo-svc"]} {
	${vigil} --socket ${tmpdir}/vigild.sock services start demo-svc
}
process p1 -expect-text 0 0 "process started"
shell -match {demo-svc +disabled +active} {
	${vigil} --socket ${tmpdir}/vigild.sock services list
}

# Restart and stop.
shell -expect {[done]: Restart ["demo-svc"]} {
	${vigil} --socket ${tmpdir}/vigild.sock services restart demo-svc
}
process p1 -expect-text 0 0 "process exited"
shell -expect {[done]: Stop ["demo-svc"]} {
	${vigil} --socket ${tmpdir}/vigild.sock services stop demo-svc
}

# Identities: none (bootstrap), then ci-user, then none again.
shell -expect "No identities." { ${vigil} --socket ${tmpdir}/vigild.sock identities list }
shell -expect "Identity 'ci-user' added." {
	${vigil} --socket ${tmpdir}/vigild.sock identities add-local ci-user --access admin
}
shell -match {ci-user +admin +local[(]any[)] +api} {
	${vigil} --socket ${tmpdir}/vigild.sock identities list
}
shell -expect "Removed: ci-user" {
	${vigil} --socket ${tmpdir}/vigild.sock identities remove ci-user
}
shell -expect "No identities." { ${vigil} --socket ${tmpdir}/vigild.sock identities list }

process p1 -kill TERM
process p1 -wait
